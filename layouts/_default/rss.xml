{{- /*
  ============================================================================
  RSS-FEED ("Nachrichten-Abo" der Website)
  ============================================================================
  Hugo erzeugt von sich aus zu jeder Übersichtsseite eine index.xml - eine
  maschinenlesbare Kurzfassung der jeweils enthaltenen Beiträge, die
  Nachrichten-Apps und Newsreader abonnieren können. Diese Datei ersetzt
  Hugos eingebaute Version aus genau einem Grund:

  Seiten mit "geschuetzt: true" im Frontmatter (der Mitgliederbereich unter
  content/<sprache>/mitglieder/) dürfen dort NICHT auftauchen. Sonst wäre
  der komplette Text dieser Seiten über die Feed-Adresse frei abrufbar -
  völlig ohne Passwort, weil die Passwort-Abfrage nur vor die HTML-Seiten
  gelegt wird, nicht vor die XML-Dateien daneben. Das war beim Anlegen des
  Mitgliederbereichs tatsächlich der Fall und ist genau deshalb hier
  abgestellt.

  Zusätzlich haben die _index.md-Dateien des Mitgliederbereichs
  "outputs: ['html']" gesetzt - dadurch entsteht für diesen Bereich gar
  keine eigene index.xml mehr. Beides zusammen (kein eigener Feed + Filter
  in allen anderen Feeds) sorgt dafür, dass geschützte Inhalte nirgends in
  einem Feed landen.

  Ausserdem (Testlauf 2026-10):
  - Titel und Beschreibung des Feeds in der Sprache der Seite statt Hugos
    englischem "… on NCWiki" / "Recent content in …".
  - Erfahrungsberichte haben kein "title:" - ihr Titel entsteht wie auf der
    Seite aus Name und Jahr ("Anna K. – EMS 2024"). Vorher standen sie ohne
    Titel im Feed.
  - Nur Seiten mit Datum: Seiten ohne "date:" (Übungsseiten, Uniguide …)
    standen sonst mit dem Datum "1. Januar 0001" darin.
  - Newsletter-Seiten erst, wenn der Newsletter eingerichtet ist (wie in
    Sitemap und head.html).

  ACHTUNG beim Bearbeiten: Das ist eine XML-Datei, kein HTML. Wer hier etwas
  ändert, sollte danach lokal "hugo --minify" laufen lassen und einmal in
  public/index.xml hineinschauen.
  ============================================================================
*/ -}}
{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- /* Der eigentliche Zweck dieser Datei: geschützte Seiten rauswerfen. */ -}}
{{- $pages = where $pages "Params.geschuetzt" "!=" true -}}
{{- if not site.Params.newsletter_url }}{{ $pages = where $pages "Params.newsletter_seite" "!=" true }}{{ end -}}
{{- $mitDatum := slice -}}
{{- range $pages }}{{ if not .Date.IsZero }}{{ $mitDatum = $mitDatum | append . }}{{ end }}{{ end -}}
{{- $pages = $mitDatum -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if or .IsHome (eq .Title .Site.Title) }}{{ .Site.Title }}{{ else }}{{ .Title }} – {{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ or .Description (i18n "site_tagline") | plainify }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    {{- $titel := .Title }}
    {{- if and (not $titel) .Params.name .Params.jahr }}{{ $titel = printf "%s – %s %v" .Params.name (i18n "ems_kurz") .Params.jahr }}{{ end }}
    <item>
      <title>{{ $titel }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | plainify | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
